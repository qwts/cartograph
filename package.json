{
  "name": "cartograph",
  "private": true,
  "version": "0.15.1",
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "changeset:version": "changeset version && npm run version:sync",
    "package:macos": "tauri build --bundles app,dmg --target universal-apple-darwin",
    "package:macos:compile": "tauri build --no-bundle --target universal-apple-darwin",
    "package:macos:bundle": "tauri bundle --bundles app,dmg --target universal-apple-darwin",
    "tauri": "tauri",
    "check:traceability": "node scripts/check-traceability.mjs",
    "test:version": "node --test scripts/*.test.mjs",
    "version:check": "node scripts/version.mjs check",
    "version:sync": "node scripts/version.mjs sync"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@tauri-apps/cli": "^2.11.4"
  }
}
